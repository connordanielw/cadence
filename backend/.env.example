# Anthropic API for Claude tagging
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI for embeddings (now part of Anthropic; separate key)
VOYAGE_API_KEY=pa-...

# Database
# Native (Homebrew Postgres): localhost
# docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5432/cadence

# Where uploaded files live
STORAGE_DIR=./storage

# Models
CLAUDE_MODEL=claude-sonnet-4-6
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024

# CORS — frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000
